# Nunca publique suas chaves. Configure os valores reais no painel do Render.
# openrouter mantém o modo atual; local usa um servidor próprio OpenAI-compatible.
LLM_PROVIDER=openrouter
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio
APP_PASSWORD=crie-uma-senha-forte
DATABASE_URL=sqlite:///./mikael_ai.db
LLM_API_KEY=sua-chave-do-provedor
LLM_BASE_URL=https://openrouter.ai/api/v1

# Motor próprio (LLM_PROVIDER=local). Não usa LLM_API_KEY nem faz fallback para OpenRouter.
# Use HTTPS e configure autenticação no servidor; nunca exponha inferência pública sem proteção.
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=token-do-servidor-proprio
LLM_LOCAL_MODEL=mikael-coder
LLM_LOCAL_VISION_MODEL=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_REASONING_EFFORT=high
LLM_WEB_SEARCH_ENABLED=true
LLM_WEB_SEARCH_ENGINE=exa
LLM_WEB_SEARCH_MAX_RESULTS=5
LLM_IMAGE_MODEL=google/gemini-2.5-flash-image
MAX_UPLOAD_MB=8

# GitHub OAuth App (crie no GitHub Developer Settings)
GITHUB_CLIENT_ID=seu-client-id
GITHUB_CLIENT_SECRET=seu-client-secret
GITHUB_REDIRECT_URI=https://mikael-ai.onrender.com/api/connectors/github/callback
